Table notifications {
  id varchar(36) [pk, not null]
  user_id varchar(36)
  recipient varchar(255) [not null]
  channel varchar(50) [not null]
  subject varchar(255)
  message text [not null]
  status varchar(20) [not null]
  created_at datetime [not null]
  sent_at datetime
  Indexes {
    created_at [name: 'ix_notifications_created_at']
    status [name: 'ix_notifications_status']
  }
  Note: '''channel IN ('EMAIL','SMS','PUSH'); status IN ('PENDING','SENT','FAILED')'''
}
