digraph schema {
graph [rankdir=LR, bgcolor="white"];
node [shape=plain fontname="Arial"];
sensors [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>sensors</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">name: VARCHAR(255) not null</TD></TR><TR><TD ALIGN="LEFT">type: VARCHAR(100) not null</TD></TR><TR><TD ALIGN="LEFT">location: VARCHAR(255) nullable</TD></TR><TR><TD ALIGN="LEFT">unit: VARCHAR(50) not null</TD></TR><TR><TD ALIGN="LEFT">latitude: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">longitude: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">api_key_hash: VARCHAR(64) not null</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20) not null</TD></TR><TR><TD ALIGN="LEFT">last_seen_at: DATETIME nullable</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR></TABLE>>];
sensor_readings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>sensor_readings</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">sensor_id: VARCHAR(36) not null, ref: &gt; sensors.id</TD></TR><TR><TD ALIGN="LEFT">value: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">unit: VARCHAR(50) nullable</TD></TR><TR><TD ALIGN="LEFT">measured_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">received_at: DATETIME not null</TD></TR></TABLE>>];
sensors -> sensor_readings [label="1:N sensor_id"];
}
