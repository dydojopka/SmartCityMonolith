FROM python:3.12-slim AS dependencies

WORKDIR /service
COPY benchmarks/baseline/notification-service/requirements.txt constraints.txt ./
RUN pip install --no-cache-dir -c constraints.txt -r requirements.txt

COPY benchmarks/baseline/utility-service/requirements.txt ./utility-requirements.txt
RUN python -c "from pathlib import Path; assert Path('requirements.txt').read_bytes() == Path('utility-requirements.txt').read_bytes(), 'Baseline requirements must match'" \
    && mkdir -p /data

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]

FROM dependencies AS notification
COPY benchmarks/baseline/notification-service/app ./app

FROM dependencies AS utility
COPY benchmarks/baseline/utility-service/app ./app
