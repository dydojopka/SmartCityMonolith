digraph schema {
graph [rankdir=LR, bgcolor="white"];
node [shape=plain fontname="Arial"];
parkings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>parkings</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">name: VARCHAR(200) not null</TD></TR><TR><TD ALIGN="LEFT">address: VARCHAR(300) not null</TD></TR><TR><TD ALIGN="LEFT">latitude: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">longitude: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">total_spaces: INTEGER not null</TD></TR><TR><TD ALIGN="LEFT">available_spaces: INTEGER not null</TD></TR><TR><TD ALIGN="LEFT">price_per_hour_cents: INTEGER not null</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">updated_at: DATETIME not null</TD></TR></TABLE>>];
vehicles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>vehicles</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">type: VARCHAR(30) not null</TD></TR><TR><TD ALIGN="LEFT">route_number: VARCHAR(30) not null</TD></TR><TR><TD ALIGN="LEFT">plate_number: VARCHAR(20) nullable</TD></TR><TR><TD ALIGN="LEFT">model: VARCHAR(100) nullable</TD></TR><TR><TD ALIGN="LEFT">latitude: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">longitude: FLOAT not null</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20) not null</TD></TR><TR><TD ALIGN="LEFT">updated_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR></TABLE>>];
reservations [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>reservations</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">parking_id: VARCHAR(36) not null, ref: &gt; parkings.id</TD></TR><TR><TD ALIGN="LEFT">user_id: VARCHAR(36) not null</TD></TR><TR><TD ALIGN="LEFT">request_key: VARCHAR(128) nullable</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20) not null</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">expires_at: DATETIME nullable</TD></TR></TABLE>>];
parkings -> reservations [label="1:N parking_id"];
}
