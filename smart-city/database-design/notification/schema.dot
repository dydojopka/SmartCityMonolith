digraph schema {
graph [rankdir=LR, bgcolor="white"];
node [shape=plain fontname="Arial"];
notifications [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">user_id: VARCHAR(36) nullable</TD></TR><TR><TD ALIGN="LEFT">recipient: VARCHAR(255) not null</TD></TR><TR><TD ALIGN="LEFT">channel: VARCHAR(50) not null</TD></TR><TR><TD ALIGN="LEFT">subject: VARCHAR(255) nullable</TD></TR><TR><TD ALIGN="LEFT">message: TEXT not null</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20) not null</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">sent_at: DATETIME nullable</TD></TR></TABLE>>];
}
