# Только локальная учебная среда, не публичное развёртывание.
# Один набор секретов используется всеми backend-компонентами этого стенда.
JWT_SECRET=development-jwt-secret
SERVICE_TOKEN=development-service-token
SENSOR_API_KEY=demo-sensor-key
DEMO_PAYMENTS_ENABLED=true
NOTIFICATION_FAIL_SEND=false

# По умолчанию CORS следует FRONTEND_PORT. Для другого origin задать явно:
# CORS_ORIGINS=http://localhost:5173
IDENTITY_PORT=8001
TRANSPORT_PORT=8002
UTILITY_PORT=8003
ENVIRONMENT_PORT=8004
BILLING_PORT=8005
NOTIFICATION_PORT=8006
FRONTEND_PORT=5173
