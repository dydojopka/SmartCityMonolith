digraph schema {
graph [rankdir=LR, bgcolor="white"];
node [shape=plain fontname="Arial"];
invoices [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>invoices</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">user_id: VARCHAR(36) not null</TD></TR><TR><TD ALIGN="LEFT">amount_cents: INTEGER not null</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20) not null</TD></TR><TR><TD ALIGN="LEFT">description: VARCHAR(300) nullable</TD></TR><TR><TD ALIGN="LEFT">due_date: DATE nullable</TD></TR><TR><TD ALIGN="LEFT">paid_at: DATETIME nullable</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">updated_at: DATETIME not null</TD></TR></TABLE>>];
payments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">invoice_id: VARCHAR(36) not null, ref: &gt; invoices.id</TD></TR><TR><TD ALIGN="LEFT">user_id: VARCHAR(36) not null</TD></TR><TR><TD ALIGN="LEFT">amount_cents: INTEGER not null</TD></TR><TR><TD ALIGN="LEFT">status: VARCHAR(20) not null</TD></TR><TR><TD ALIGN="LEFT">idempotency_key: VARCHAR(128) not null</TD></TR><TR><TD ALIGN="LEFT">external_event_id: VARCHAR(128) nullable</TD></TR><TR><TD ALIGN="LEFT">created_at: DATETIME not null</TD></TR><TR><TD ALIGN="LEFT">updated_at: DATETIME not null</TD></TR></TABLE>>];
invoices -> payments [label="1:N invoice_id"];
webhook_events [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#2457d6"><FONT COLOR="white"><B>webhook_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT">id: VARCHAR(36) pk, not null</TD></TR><TR><TD ALIGN="LEFT">external_event_id: VARCHAR(128) not null</TD></TR><TR><TD ALIGN="LEFT">payment_id: VARCHAR(36) not null, ref: &gt; payments.id</TD></TR><TR><TD ALIGN="LEFT">event_type: VARCHAR(50) not null</TD></TR><TR><TD ALIGN="LEFT">payload: JSON nullable</TD></TR><TR><TD ALIGN="LEFT">processed_at: DATETIME not null</TD></TR></TABLE>>];
payments -> webhook_events [label="1:N payment_id"];
}
